<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>влалChillow</Product>
    <!-- Dashboard/log output must never depend on the operator's OS locale, and the runtime
         should not fail when a machine has no ICU data. Console text is written as UTF-8
         explicitly (see TerminalWriter / TerminalCapabilities). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyTitle>влалChillow LAN Server</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="LiteNetLib" Version="2.1.5" />
  </ItemGroup>

  <!-- Веб-панель: HTML вшивается в сборку. Один исполняемый файл, рядом с ним ничего
       не нужно — ни папки wwwroot, ни прав на запись. Имя ресурса должно совпадать с
       WebPanelHost.IndexResourceName. -->
  <ItemGroup>
    <EmbeddedResource Include="Web\wwwroot\index.html">
      <LogicalName>StandChillow.LanServer.Web.wwwroot.index.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Plugins\StandChillow.Server.Plugins\StandChillow.Server.Plugins.csproj" />
  </ItemGroup>

  <!-- Nested plugin API / src projects have their own csproj — do not compile them into the host. -->
  <ItemGroup>
    <Compile Remove="Plugins\StandChillow.Server.Plugins\**\*.cs" />
    <Compile Remove="plugins-src\**\*.cs" />
    <None Include="Plugins\StandChillow.Server.Plugins\**\*" Exclude="Plugins\StandChillow.Server.Plugins\**\bin\**;Plugins\StandChillow.Server.Plugins\**\obj\**" />
    <None Include="plugins-src\**\*" Exclude="plugins-src\**\bin\**;plugins-src\**\obj\**" />
  </ItemGroup>

  <!-- Ensure plugins/ exists beside the built exe (drop DLLs here). -->
  <Target Name="EnsurePluginsFolder" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)plugins" />
    <WriteLinesToFile
      File="$(OutputPath)plugins\.keep"
      Lines="Drop plugin DLLs here. See ../../Plugins/README.md"
      Overwrite="false"
      Condition="!Exists('$(OutputPath)plugins\.keep')" />
  </Target>

</Project>
