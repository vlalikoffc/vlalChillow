# ─────────────────────────────────────────────────────────────────────────────
# влалChillow: веб-панель по подпути
#
# Панель слушает 127.0.0.1:8080 (web.bindAddress / web.port в config.json).
# Наружу её отдаёт nginx — с тем же сертификатом, что и остальной сайт.
#
# Замени example.com на свой домен. Адреса и домены в репозитории не хранятся
# (см. CONTRIBUTING.md): рабочая конфигурация живёт на сервере.
#
# Проверка синтаксиса:  sudo nginx -t
# Применить:            sudo systemctl reload nginx
# Откат:                удалить блок и повторить reload
# ─────────────────────────────────────────────────────────────────────────────

# Без слэша на конце nginx не найдёт location /vlalchillow/ — редирект обязателен.
location = /vlalchillow {
    return 301 /vlalchillow/;
}

location /vlalchillow/ {
    # Слэш в конце proxy_pass срезает префикс: /vlalchillow/api/rooms → /api/rooms.
    # Панель умеет работать и с префиксом, и без него.
    proxy_pass http://127.0.0.1:8080/;

    proxy_http_version 1.1;

    # Панель не доверяет Host и всё равно отдаёт один и тот же HTML,
    # но честный Host нужен для логов и будущих абсолютных ссылок.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Тело запроса — только JSON на одну комнату. 16k с запасом;
    # сам сервер всё равно режет на 4 KB и отвечает 413.
    client_max_body_size 16k;

    # Панель отвечает мгновенно, но не будем копить висящие соединения.
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    proxy_connect_timeout 5s;

    # Никакого кэша: список комнат должен быть свежим.
    proxy_buffering off;
    add_header Cache-Control "no-store" always;

    # Панель уже отдаёт свои заголовки; дублируем только то, что важно и при 502.
    add_header X-Content-Type-Options "nosniff" always;
}
